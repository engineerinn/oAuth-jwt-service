# Copy to .env and adjust as needed. .env is gitignored.
DB_URL=jdbc:postgresql://localhost:5432/authdb
DB_USERNAME=authuser
DB_PASSWORD=authpass

# Token lifetimes
JWT_ACCESS_TTL_SECONDS=900       # 15 minutes
JWT_REFRESH_TTL_SECONDS=604800   # 7 days

# Auth-endpoint rate limit (per client IP)
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_WINDOW_SECONDS=60

# Demo only: seed an admin account on startup
APP_SEED_ADMIN=true
